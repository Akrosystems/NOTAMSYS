NOTAMSYS_ENVIRONMENT=development
NOTAMSYS_SECRET_KEY=replace-with-at-least-32-random-characters
NOTAMSYS_DATABASE_URL=postgresql+asyncpg://notamsys:notamsys@localhost:5432/notamsys
NOTAMSYS_REDIS_URL=redis://localhost:6379/0
NOTAMSYS_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
NOTAMSYS_OBJECT_STORAGE_ACCESS_KEY=notamsys
NOTAMSYS_OBJECT_STORAGE_SECRET_KEY=notamsys-development
NOTAMSYS_OBJECT_STORAGE_BUCKET=notamsys-evidence
NOTAMSYS_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Everything below is optional -- each capability stays off/simulated until
# its settings are supplied. See docs/INTEGRATION_REQUIREMENTS.md for what
# to request from IT (email) and ATSEP (AFTN), and docs/AFTN_BRIDGE.md for
# the AFTN bridge script's own setup.

# Per-channel publication mode overrides (each falls back to
# NOTAMSYS_PUBLICATION_MODE above when unset):
# NOTAMSYS_AFTN_MODE=async_adapters
# NOTAMSYS_GCAA_WEB_MODE=async_adapters
# NOTAMSYS_EMAIL_MODE=async_adapters

# Outbound SMTP for the Email publication channel:
# NOTAMSYS_SMTP_HOST=smtp.example.com
# NOTAMSYS_SMTP_PORT=587
# NOTAMSYS_SMTP_USERNAME=aisnotam@caa.gov.gh
# NOTAMSYS_SMTP_PASSWORD=replace-me
# NOTAMSYS_SMTP_FROM_ADDRESS=aisnotam@caa.gov.gh

# Inbound IMAP polling (python -m app.email_poller) for NOTAM request emails:
# NOTAMSYS_IMAP_HOST=imap.example.com
# NOTAMSYS_IMAP_PORT=993
# NOTAMSYS_IMAP_USERNAME=aisnotam@caa.gov.gh
# NOTAMSYS_IMAP_PASSWORD=replace-me

# Machine credential for scripts/aftn_bridge.py (ATSEP's on-prem Comsoft box):
# NOTAMSYS_AFTN_BRIDGE_API_KEY=replace-with-a-long-random-string
